# ==============================================================================
# ULASKAMI — VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES) PRODUKSI
# ==============================================================================

# 1. Domain Aplikasi Publik
# Gunakan https://ulaskami.id untuk server produksi atau http://localhost:3000 untuk pengujian lokal
NEXT_PUBLIC_APP_URL="https://ulaskami.id"

# 2. Nomor WhatsApp Layanan Pelanggan & Fallback Keluhan
# Format internasional tanpa tanda plus (+), misal: 6281234567890
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# 3. Koneksi Database Cloud PostgreSQL (PAAS.ID / Neon / Supabase)
# Jika dikosongkan, aplikasi akan berjalan dalam mode "In-Memory Safe Fallback"
# Contoh PAAS.ID: postgresql://ulaskami_user:password123@db.paas.id:5432/ulaskami_db?sslmode=require
DATABASE_URL=""

# 4. Enkripsi Sesi Merchant (Minimal 32 karakter acak untuk keamanan cookie)
SESSION_SECRET="ganti_dengan_string_acak_rahasia_minimal_32_karakter_produksi"
